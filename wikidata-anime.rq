SELECT (MIN(xsd:integer(?value)) AS ?id)
       (SAMPLE(?type) AS ?type)
       ?source
       ?lang
       (SAMPLE(?label) AS ?title)
       (SAMPLE(?finalPage) AS ?page)
       (?finalPageId AS ?pageId)
       (SAMPLE(?dateModified) AS ?dateModified)
WHERE {{
  BIND('anime' AS ?type)
  {
    ?item p:P8729 ?prop.
    ?prop rdf:type wikibase:BestRank;
          ps:P8729 ?value.
    OPTIONAL { ?prop pq:P1545 ?index. }

    OPTIONAL { ?item wdt:P364 ?originalLanguage. }
    FILTER(?originalLanguage = wd:Q5287 || !BOUND(?originalLanguage))

    ?item rdfs:label ?label.
    BIND(LANG(?label) AS ?lang)
    FILTER(?lang IN (
      "en",
      "zh", "zh-hans", "zh-hant", "zh-cn", "zh-tw",
      "zh-hk", "zh-sg", "zh-mo", "zh-my"
    ))

    ?item schema:dateModified ?dateModified.
    BIND(0 AS ?source).
  } UNION {
    ?item p:P8729 ?prop.
    ?prop rdf:type wikibase:BestRank;
          ps:P8729 ?value.
    OPTIONAL { ?prop pq:P1545 ?index. }

    OPTIONAL { ?item wdt:P364 ?originalLanguage. }
    FILTER(?originalLanguage = wd:Q5287 || !BOUND(?originalLanguage))

    ?item wdt:P144 ?origin.
    ?origin schema:dateModified ?dateModified.

    # Only use the origin title when the item itself does not already
    # have one of the wanted Chinese label variants.
    FILTER NOT EXISTS {
      ?item rdfs:label ?itemZhLabel.
      FILTER(LANG(?itemZhLabel) IN (
        "zh", "zh-hans", "zh-hant", "zh-cn", "zh-tw",
        "zh-hk", "zh-sg", "zh-mo", "zh-my"
      ))
    }

    # The English or Japanese title of the item must match the origin.
    FILTER EXISTS {
      ?item rdfs:label ?itemMatchLabel.
      ?origin rdfs:label ?originMatchLabel.
      FILTER(
        LANG(?itemMatchLabel) = LANG(?originMatchLabel) &&
        LANG(?itemMatchLabel) IN ("en", "ja") &&
        LCASE(?itemMatchLabel) = LCASE(?originMatchLabel)
      )
    }

    # Require and return the wanted Chinese title variants of the origin.
    # We have to keep these inside the UNION query because it would timeout/OOM when querying rdfs:label
    # on variables that are bounded with BIND, e.g. `BIND(?origin AS ?labelItem)`.
    ?origin rdfs:label ?label.
    BIND(LANG(?label) AS ?lang)
    FILTER(?lang IN (
      "zh", "zh-hans", "zh-hant", "zh-cn", "zh-tw",
      "zh-hk", "zh-sg", "zh-mo", "zh-my"
    ))

    BIND(1 AS ?source).
  } UNION {
    ?item p:P8729 ?prop.
    ?prop rdf:type wikibase:BestRank;
          ps:P8729 ?value.
    OPTIONAL { ?prop pq:P1545 ?index. }

    OPTIONAL { ?item wdt:P364 ?originalLanguage. }
    FILTER(?originalLanguage = wd:Q5287 || !BOUND(?originalLanguage))

    # Query the title of the series, if the anime is the first season of it
    ?item p:P179 [
      pq:P1545 "1";
      ps:P179 ?series;
    ].

    {
      ?series rdfs:label ?label.
      BIND(LANG(?label) AS ?lang).
      FILTER(?lang IN (
        "zh", "zh-hans", "zh-hant", "zh-cn", "zh-tw",
        "zh-hk", "zh-sg", "zh-mo", "zh-my"
      ))

      ?series schema:dateModified ?dateModified.
      BIND(2 AS ?source).
    } UNION {
      ?series wdt:P144 ?origin.

      # Similar to the branch above, but for the series
      FILTER NOT EXISTS {
        ?series rdfs:label ?seriesZhLabel.
        FILTER(LANG(?seriesZhLabel) IN (
          "zh", "zh-hans", "zh-hant", "zh-cn", "zh-tw",
          "zh-hk", "zh-sg", "zh-mo", "zh-my"
        ))
      }

      FILTER EXISTS {
        ?series rdfs:label ?seriesMatchLabel.
        ?origin rdfs:label ?originMatchLabel.
        FILTER(
          LANG(?seriesMatchLabel) = LANG(?originMatchLabel) &&
          LANG(?seriesMatchLabel) IN ("en", "ja") &&
          LCASE(?seriesMatchLabel) = LCASE(?originMatchLabel)
        )
      }

      ?origin rdfs:label ?label.
      BIND(LANG(?label) AS ?lang).
      FILTER(?lang IN (
        "zh", "zh-hans", "zh-hant", "zh-cn", "zh-tw",
        "zh-hk", "zh-sg", "zh-mo", "zh-my"
      )).

      ?origin schema:dateModified ?dateModified.
      BIND(3 AS ?source).
    }
  }

  OPTIONAL {
    ?item p:P5737 ?pageStatement.
    ?pageStatement rdf:type wikibase:BestRank;
                   ps:P5737 ?page;
                   pq:P9675 ?pageId.
  }

  OPTIONAL {
    ?item wdt:P179 ?series
    OPTIONAL {
      ?series p:P5737 ?seriesPageStatement.
      ?seriesPageStatement rdf:type wikibase:BestRank;
                           ps:P5737 ?seriesPage;
                           pq:P9675 ?seriesPageId.
    }
    OPTIONAL {
      ?series wdt:P144/p:P5737 ?seriesOriginPageStatement.
      ?seriesOriginPageStatement rdf:type wikibase:BestRank;
                                 ps:P5737 ?seriesOriginPage;
                                 pq:P9675 ?seriesOriginPageId.
      OPTIONAL { ?seriesOriginPageStatement pq:P407 ?seriesOriginPageLang }
      FILTER(!BOUND(?seriesOriginPageLang) || ?seriesOriginPageLang = wd:Q7850)
    }
    # The link to the media mix page of the series
    OPTIONAL {
      ?series wdt:P8345/p:P5737 ?seriesMedmixPageStatement.
      ?seriesMedmixPageStatement rdf:type wikibase:BestRank;
                                 ps:P5737 ?seriesMedmixPage;
                                 pq:P9675 ?seriesMedmixPageId.
    }
  }

  OPTIONAL {
    ?item wdt:P144 ?origin
    OPTIONAL {
      ?origin p:P5737 ?originPageStatement.
      ?originPageStatement rdf:type wikibase:BestRank;
                           ps:P5737 ?originPage;
                           pq:P9675 ?originPageId.
      # Filter out pages in non-Chinese languages
      OPTIONAL { ?originPageStatement pq:P407 ?originPageLang }
    }
    FILTER(!BOUND(?originPageLang) || ?originPageLang = wd:Q7850)
  }

  OPTIONAL {
    ?item wdt:P8345/p:P5737 ?medmixPageStatement.
    ?medmixPageStatement rdf:type wikibase:BestRank;
                         ps:P5737 ?medmixPage;
                         pq:P9675 ?medmixPageId.
  }

  BIND(COALESCE(?page, ?seriesPage, ?seriesOriginPage, ?originPage, ?medmixPage, ?seriesMedmixPage) AS ?finalPage)
  BIND(COALESCE(?pageId, ?seriesPageId, ?seriesOriginPageId, ?originPageId, ?medmixPageId, ?seriesMedmixPageId) AS ?finalPageId)
  FILTER(BOUND(?finalPage) || ?lang IN (
    "zh", "zh-hans", "zh-hant", "zh-cn", "zh-tw",
    "zh-hk", "zh-sg", "zh-mo", "zh-my"
  ))
}}
GROUP BY ?item ?source ?lang ?index ?finalPageId
ORDER BY ?id ?source ?lang ?finalPageId
